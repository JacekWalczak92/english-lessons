# Publiczny URL projektu Supabase — używany także przez Android.
NEXT_PUBLIC_SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co

# Supabase -> Project Settings / API Keys -> Publishable key (sb_publishable_...)
# To jest klucz publiczny i może trafić do statycznego frontendu.
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# Google Cloud -> OAuth 2.0 Client ID -> Web application
NEXT_PUBLIC_GOOGLE_CLIENT_ID=

# Lokalnie zostaw puste. GitHub Actions ustawia tę wartość automatycznie na /NAZWA_REPO.
# Dla repo USERNAME.github.io workflow ustawi pusty base path.
NEXT_PUBLIC_BASE_PATH=
